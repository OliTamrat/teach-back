# Copy to .env.local. Never commit a real value.

# Meta Model API (https://api.meta.ai/v1). Text analysis on Spark 1.3; audio on Spark 1.2 per Meta's docs.
META_MODEL_API_KEY=
META_MODEL_BASE_URL=https://api.meta.ai/v1
META_SPARK_MODEL=muse-spark-1.3
META_SPARK_AUDIO_MODEL=muse-spark-1.2
META_SAM_MODEL=sam-3.1
META_VOICE_MODEL=muse-voice-transcribe-1.0

# Omnilingual ASR, self-hosted as the Kintale Hugging Face Space (Kintale/services/asr). Reused here.
# Same values as the Kintale project's TRANSCRIBE_URL and TRANSCRIBE_TOKEN in Vercel:
#   the Space's own address, lower case, e.g. https://<owner>-kintale-asr.hf.space/
#   and a Hugging Face read token (a private Space refuses without one).
# A sleeping Space takes 15 to 25 minutes to wake; GET /api/health?probe=asr says whether it is ready.
ASR_SERVICE_URL=
ASR_SERVICE_TOKEN=
# Set to off to disable the Muse Voice Transcribe fallback first listener (for an evaluation of Omnilingual alone).
META_VOICE_FALLBACK=
